    const d=document.createElement('div');d.className='audio-item track-item';
    d.innerHTML=`<input type="checkbox" title="Auf Karte anzeigen" ${t.visible!==false?'checked':''} data-track-toggle="${esc(t.id)}"><div><b style="color:#6fffb0">${esc(t.name||'Track')}</b><div class="tiny">${t.points||trackPointsFromGeometry(t).length} Punkte · ${(Number(t.distance||0)/1000).toFixed(2)} km · ${t.startedAt?new Date(t.startedAt).toLocaleString('de-DE'):''}</div></div><div class="track-actions"><button class="btn" title="Auf Track zoomen" data-track-zoom="${esc(t.id)}">⌕</button><button class="btn" title="Track bearbeiten" data-track-edit="${esc(t.id)}">✎</button><button class="btn danger" title="Track löschen" data-track-delete="${esc(t.id)}">⌫</button></div>`;
