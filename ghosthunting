function detectDeviceMode(){
  const ua=navigator.userAgent||'';
  const mobileUA=/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini|Mobile/i.test(ua);
  const touch=navigator.maxTouchPoints>0 || 'ontouchstart' in window;
  const narrow=window.matchMedia ? window.matchMedia('(max-width: 900px)').matches : window.innerWidth<=900;
  const coarse=window.matchMedia ? window.matchMedia('(pointer: coarse)').matches : false;
  const mobile=mobileUA || (touch && narrow) || (coarse && narrow);

  document.body.classList.toggle('is-mobile',mobile);
  document.body.classList.toggle('is-desktop',!mobile);
  document.body.dataset.device=mobile?'mobile':'desktop';

  const badge=$('deviceModeBadge');
  if(badge)badge.textContent=mobile?'MOBILE':'DESKTOP';

  setTimeout(()=>map?.invalidateSize?.(),100);
  return mobile;
}
function setupResponsiveUI(){
  detectDeviceMode();
  window.addEventListener('resize',()=>detectDeviceMode(),{passive:true});
  window.addEventListener('orientationchange',()=>setTimeout(detectDeviceMode,120),{passive:true});

  document.querySelectorAll('[data-mobile-tab]').forEach(btn=>{
    btn.addEventListener('click',e=>{
      e.preventDefault();
      const tab=btn.dataset.mobileTab;
      document.querySelectorAll('#mobileNav .nav-btn').forEach(b=>b.classList.toggle('active',b===btn));

      if(tab==='map'){
        document.body.classList.remove('sidebar-open');
      }else if(tab==='menu'){
        document.body.classList.add('sidebar-open');
      }else if(tab==='cases'){
        document.body.classList.remove('sidebar-open');
        const c=map?.getCenter();
        if(c)openCaseModal(c.lat,c.lng);
      }else if(tab==='report'){
        document.body.classList.remove('sidebar-open');
        if(window.GhosthuntReport?.open) window.GhosthuntReport.open();
        else toast('Bericht ist noch nicht verfügbar.','warn');
      }
      setTimeout(()=>map?.invalidateSize?.(),120);
    });
  });
}

