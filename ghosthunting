<style>
:root{--bg:#040807;--panel:#0b1512;--panel2:#0f1d18;--line:#1d352d;--text:#e0ebe7;--muted:#779087;--green:#6fffb0;--cyan:#00e5ff;--red:#ff647c;--amber:#ffd166;--shadow:0 20px 70px rgba(0,0,0,.5)}
*{box-sizing:border-box}html,body{height:100%;margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.hidden{display:none!important}
.app{height:100dvh;display:grid;grid-template-rows:64px 1fr;overflow:hidden}.topbar{display:flex;align-items:center;justify-content:space-between;padding:0 15px;border-bottom:1px solid var(--line);background:rgba(4,8,7,.92);backdrop-filter:blur(14px);z-index:2000}.brand{display:flex;align-items:center;gap:10px}.mark{width:38px;height:38px;border-radius:12px;border:1px solid #325548;display:grid;place-items:center;background:#09130f}.mark svg{width:25px}.brand h1{font-size:14px;margin:0;color:var(--green);letter-spacing:.14em;text-transform:uppercase}.brand small{display:block;color:var(--muted);font-size:9px;letter-spacing:.08em}.top-actions{display:flex;gap:7px;align-items:center}.btn{border:1px solid #2a473c;background:#0b1512;color:var(--text);padding:8px 10px;border-radius:10px;transition:.15s}.btn:hover{background:#102019;border-color:#3e6f5e}.btn.primary{color:var(--green);border-color:#2b6a53;background:#0e241b}.btn.cyan{color:var(--cyan);border-color:#1d6671;background:#0c2025}.btn.danger{color:#ffa2b2;border-color:#6c3444}.iconbtn{width:36px;height:36px;padding:0;display:grid;place-items:center}.status{font-size:10px;color:var(--muted);display:flex;align-items:center;gap:6px}.status .dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 12px rgba(111,255,176,.7)}.status.offline .dot{background:var(--amber)}
.main{display:grid;grid-template-columns:320px 1fr;min-height:0}.sidebar{min-height:0;overflow:auto;padding:12px;background:linear-gradient(180deg,#09120f,#050908);border-right:1px solid var(--line)}.section{border:1px solid var(--line);border-radius:14px;background:linear-gradient(180deg,rgba(15,29,24,.82),rgba(7,13,11,.88));padding:12px;margin-bottom:10px;box-shadow:var(--shadow)}.section h2{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#9db8ad;margin:0 0 9px}.quick{display:grid;grid-template-columns:1fr 1fr;gap:7px}.field{display:grid;gap:5px;margin:7px 0}.field label{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em}.field input,.field select,.field textarea{width:100%;background:#06100c;border:1px solid #203930;color:var(--text);border-radius:9px;padding:8px;outline:none}.field textarea{min-height:90px;resize:vertical}.field input:focus,.field select:focus,.field textarea:focus{border-color:#4a866f;box-shadow:0 0 0 3px rgba(111,255,176,.05)}select[multiple]{min-height:120px}.range{display:grid;grid-template-columns:1fr 45px;gap:8px;align-items:center}.range input{width:100%;accent-color:var(--green)}.range output{text-align:right;font-size:10px;color:var(--green)}.fold{display:flex;align-items:center;gap:7px}.fold button{margin-left:auto}.subpanel{margin-top:8px;padding:9px;border:1px solid #1b3028;border-radius:10px;background:#07100d}.tiny{font-size:10px;color:var(--muted)}
#mapWrap{position:relative;min-width:0;min-height:0}#map{position:absolute;inset:0}.map-actions{position:absolute;left:12px;top:12px;z-index:1200;display:flex;gap:7px;flex-wrap:wrap}.measure-btn{display:flex;align-items:center;gap:6px}.measure-btn svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.measure-btn.active{border-color:var(--cyan);color:var(--cyan);box-shadow:0 0 20px rgba(0,229,255,.12)}.measure-panel{position:absolute;left:12px;top:58px;z-index:1600;width:280px;background:rgba(6,12,10,.97);border:1px solid #2a4d40;border-radius:14px;box-shadow:var(--shadow);backdrop-filter:blur(12px)}.measure-panel.show{display:block}.measure-head{display:flex;align-items:center;justify-content:space-between;padding:9px 10px;border-bottom:1px solid var(--line)}.measure-head strong{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--green)}.measure-tools{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:9px}.measure-tools .btn{font-size:10px;padding:7px}.measure-readout{padding:0 10px 10px;color:#8ca49b;font-size:10px;line-height:1.45}.measure-readout b{color:var(--cyan)}.map-actions .btn{background:rgba(5,10,8,.9);backdrop-filter:blur(9px)}.legend{position:absolute;bottom:12px;left:12px;z-index:1200;background:rgba(5,10,8,.88);border:1px solid var(--line);padding:9px 11px;border-radius:12px;min-width:210px}.legend div{font-size:9px;color:var(--muted);display:flex;justify-content:space-between;gap:15px}.legend strong{color:var(--green)}.leaflet-container{background:#d7dde1}.leaflet-control-layers{background:rgba(7,13,11,.95)!important;color:#dce9e3;border:1px solid #28483c!important}.leaflet-control-layers label{color:#dce9e3}.leaflet-control-layers-separator{border-color:#28483c}.leaflet-control-zoom a,.leaflet-bar a{background:#0b1512;color:#dce9e3;border-color:#254238}.leaflet-control-zoom a:hover{background:#12241e;color:var(--green)}.leaflet-popup-content-wrapper,.leaflet-popup-tip{background:#0b1512;color:#dce9e3;border:1px solid #2a4b3f}.popup{min-width:230px}.popup h3{font-size:13px;color:var(--green);margin:0 0 5px}.popup .meta{font-size:10px;color:#89a098;line-height:1.5}.popup p{font-size:10px;line-height:1.5;color:#c1d2cb}.popup img{max-width:100%;max-height:150px;border-radius:8px;margin-top:6px}.popup audio{width:100%;margin-top:6px}.cluster-badge{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#0b3327;border:1px solid #65e8ad;color:#d5ffe8;box-shadow:0 0 18px rgba(111,255,176,.3);font-weight:700}.annotation-text{font-weight:700;text-shadow:0 2px 10px #000,0 0 12px #000;white-space:pre-line;pointer-events:auto}.draw-panel{position:absolute;top:12px;right:12px;z-index:1500;width:min(470px,calc(100% - 24px));background:rgba(6,12,10,.95);border:1px solid #2a4d40;border-radius:14px;box-shadow:var(--shadow);backdrop-filter:blur(13px)}.draw-head{display:flex;justify-content:space-between;align-items:center;padding:9px 10px;border-bottom:1px solid var(--line)}.draw-head strong{font-size:10px;color:var(--green);letter-spacing:.08em;text-transform:uppercase}.draw-tools{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;padding:9px}.draw-tools .btn{font-size:10px;padding:7px}.draw-tools .btn.active{border-color:var(--cyan);color:var(--cyan);box-shadow:0 0 18px rgba(0,229,255,.08)}
.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.68);display:none;align-items:center;justify-content:center;padding:15px;z-index:5000}.modal-backdrop.show{display:flex}.modal{width:min(1060px,96vw);max-height:94vh;overflow:auto;background:linear-gradient(165deg,#0d1915,#07100d);border:1px solid #2b4b40;border-radius:18px;box-shadow:0 35px 120px rgba(0,0,0,.7)}.modal-head{display:flex;align-items:center;justify-content:space-between;padding:13px 15px;border-bottom:1px solid var(--line);position:sticky;top:0;background:rgba(8,14,11,.94);backdrop-filter:blur(13px);z-index:2}.modal-head h2{font-size:12px;margin:0;color:var(--green);letter-spacing:.12em;text-transform:uppercase}.modal-body{padding:14px}.modal-foot{display:flex;justify-content:flex-end;gap:7px;padding:11px 14px;border-top:1px solid var(--line);position:sticky;bottom:0;background:rgba(8,14,11,.94);backdrop-filter:blur(13px)}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.full{grid-column:1/-1}.readonly{opacity:.9}.astro-card{border:1px solid var(--line);border-radius:10px;padding:8px;background:#08120e}.astro-card label{font-size:8px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em}.astro-card input,.astro-card select{margin-top:5px;width:100%;background:#07100d;border:1px solid #233c32;color:var(--text);border-radius:8px;padding:6px;font-size:10px}.astro-actions{display:flex;gap:7px;align-items:center;margin-top:8px}.table-head{display:flex;align-items:center;gap:7px}.column-wrap{position:relative}.column-menu{position:absolute;left:0;top:39px;display:none;min-width:245px;max-height:420px;overflow:auto;padding:9px;background:#09130f;border:1px solid #2c4c40;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,.6);z-index:100}.column-menu.show{display:block}.column-menu .head{display:flex;gap:6px;margin-bottom:7px}.column-menu .head .btn{font-size:9px;padding:5px 7px}.column-item{display:flex;align-items:center;gap:7px;padding:5px;border-radius:7px;font-size:10px;color:#bed0c8}.column-item:hover{background:#102019}.column-item input{accent-color:var(--green)}.table-shell{height:min(72vh,700px)}
.paint-grid{display:grid;grid-template-columns:210px 1fr;gap:10px}.paint-tools{border:1px solid var(--line);border-radius:12px;padding:9px;background:#07100d}.paint-tools .btn{width:100%;margin-bottom:6px}.paint-canvas-wrap{background:#020504;border:1px solid #20382e;border-radius:12px;display:flex;align-items:center;justify-content:center;overflow:auto;padding:10px}.paint-canvas{background:#f3f5f2;max-width:100%;height:auto}.track-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.stat{border:1px solid var(--line);border-radius:10px;padding:8px;background:#08120f}.stat b{display:block;font-size:8px;color:var(--muted);text-transform:uppercase}.stat span{font-size:12px;color:var(--cyan)}.wave{width:100%;height:180px;background:#030605;border:1px solid #21392f;border-radius:12px}.audio-list{display:grid;gap:7px;margin-top:8px}.audio-item{border:1px solid var(--line);border-radius:10px;padding:8px;background:#07100d}.report-pick{display:grid;grid-template-columns:repeat(2,1fr);gap:6px;max-height:340px;overflow:auto}.report-pick label{display:flex;gap:7px;padding:7px;border:1px solid #1a2f27;border-radius:8px;background:#07100d;font-size:10px}.fold-open{display:none;margin-top:8px}.fold-open.show{display:block}.gear{font-size:13px}.leaflet-measure-action a{background:#0b1512!important;color:#dce9e3!important}.leaflet-measure-resultpopup{background:#0b1512;color:#dce9e3;border:1px solid #29483d}.measure-active .leaflet-map-pane{cursor:crosshair}.recording{color:var(--red)!important;border-color:#6a3342!important;box-shadow:0 0 20px rgba(255,100,124,.12)}
.track-status-stat span{font-weight:800;letter-spacing:.05em}.track-status-stat.recording{background:#211016!important}.track-status-stat:not(.recording) span{color:#8ea39b!important}
.audio-actions{display:flex;gap:5px;justify-content:flex-end;margin-top:6px}.audio-item audio{max-width:100%}.track-item{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center}.track-actions{display:flex;gap:4px}.track-actions .btn{padding:4px 7px;font-size:9px}.track-edit-handle{background:#07100d!important;border:2px solid #00e5ff!important}.track-mid-handle{background:#09241b!important;border:2px dashed #6fffb0!important}

@media(max-width:900px){.main{grid-template-columns:275px 1fr}.grid3,.grid4{grid-template-columns:1fr 1fr}.paint-grid{grid-template-columns:1fr}.top-actions .status,.brand small{display:none}}@media(max-width:700px){.app{grid-template-rows:56px 1fr}.main{grid-template-columns:1fr;grid-template-rows:auto 1fr}.sidebar{max-height:42dvh;border-right:0;border-bottom:1px solid var(--line)}.quick{grid-template-columns:repeat(3,1fr)}.grid2,.grid3,.grid4,.report-pick{grid-template-columns:1fr}.draw-tools{grid-template-columns:repeat(3,1fr)}}

.case-mode-active{background:#3a171f!important;border-color:#ff647c!important;color:#ffd7de!important;box-shadow:0 0 22px rgba(255,100,124,.18)!important}
.report-open-btn{position:relative}
.report-open-btn:after{content:'✓';position:absolute;right:-5px;top:-5px;display:none;width:14px;height:14px;border-radius:50%;background:#6fffb0;color:#06100c;font-size:9px;line-height:14px;text-align:center;font-weight:800}
</style>
</head>
<body>
<div class="app">
<header class="topbar">
  <div class="brand"><div class="mark"><svg viewBox="0 0 64 64" fill="none"><path d="M16 46V23c0-11 7-17 16-17s16 6 16 17v23l-5-5-5 5-6-5-6 5-5-5-5 5z" stroke="#6fffb0" stroke-width="3"/><circle cx="25" cy="26" r="3" fill="#6fffb0"/><circle cx="39" cy="26" r="3" fill="#6fffb0"/><path d="M25 37c5 4 9 4 14 0" stroke="#00e5ff" stroke-width="2"/></svg></div><div><h1>Ghosthunting // Anomalien</h1><small>FELDDATENBANK · GEO · EVP · ROUTEN · BERICHTE</small></div></div>
  <div class="top-actions"><div id="deviceModeBadge" class="device-badge device-desktop-only">DESKTOP</div>
      <div id="netStatus" class="status"><span class="dot"></span><span>ONLINE</span></div><button class="btn iconbtn" id="btnExport" title="JSON exportieren">⇩</button><button class="btn iconbtn" id="btnImport" title="JSON importieren">⇧</button><input id="fileImport" class="hidden" type="file" accept="application/json,.json"><button class="btn primary" id="btnNewCase">＋ Sichtung+</button></div>
</header>
<main class="main">
<aside class="sidebar">
<section class="section"><h2>Fall-Übersicht</h2><div class="quick"><button class="btn" id="btnLocate">⌾ GPS</button><button class="btn cyan" id="btnGroundplan">▧ Grundriss</button><button class="btn" id="btnLogbook">☷ Logbuch</button><button class="btn" id="btnTracks">⌁ Tracks</button><button class="btn" id="btnEVP">◉ EVP Studio</button><button type="button" class="btn report-open-btn" id="btnReports" type="button">▤ Bericht</button><button class="btn" id="btnFit">⌖ Fälle</button></div></section>
<section class="section"><h2>Karten</h2><div class="fold"><span class="tiny">CARTO</span><button class="btn iconbtn gear" id="btnCartoSettings" title="CARTO API-Key">⚙</button></div><div id="cartoKeyBox" class="fold-open"><div class="field"><label>API-Key</label><input id="cartoKey" type="password" autocomplete="off"></div><button class="btn primary" id="btnApplyCartoKey">Anwenden</button></div>
<div class="field"><label>Historische Karte Deckkraft</label><div class="range"><input id="histOpacity" type="range" min="0" max="100" value="70"><output id="histOpacityVal">70%</output></div></div>
<div class="field"><label>TK25 Deckkraft</label><div class="range"><input id="tk25Opacity" type="range" min="0" max="100" value="65"><output id="tk25OpacityVal">65%</output></div></div>
<div class="field"><label>Orthofoto-Deckkraft</label><div class="range"><input id="orthoOpacity" type="range" min="0" max="100" value="55"><output id="orthoOpacityVal">55%</output></div></div>
<div class="field"><label>Orthofoto</label><select id="orthoMode"><option value="esri">Esri World Imagery</option><option value="tile">Eigener Tile-Server</option><option value="wms">WMS</option><option value="image">Lokales Bild</option></select></div>
<div id="orthoUrlField" class="field hidden"><label>Tile-/WMS-URL</label><input id="orthoUrl" placeholder="https://server/{z}/{x}/{y}.png"></div><div id="orthoWmsField" class="field hidden"><label>WMS Layer</label><input id="orthoWmsLayers" placeholder="ortho:2026"></div><div id="orthoImageField" class="field hidden"><label>Bild</label><input id="orthoImage" type="file" accept="image/*"></div><div class="quick"><button class="btn primary" id="btnAddOrtho">Overlay</button><button class="btn danger" id="btnClearOrtho">Entfernen</button></div>
</section>
<section class="section"><h2>Sichtungen</h2><label class="fold"><input id="toggleHeat" type="checkbox"> Heatmap</label><label class="fold"><input id="toggleClusters" type="checkbox" checked> Cluster</label><div class="field"><label>Phänomen</label><select id="phenomenonFilter"><option value="">Alle</option><option>EVP / Stimme</option><option>Licht / Orb</option><option>Schatten / Gestalt</option><option>EMF-Anomalie</option><option>Temperatur-Anomalie</option><option>Bewegung / Sensor</option><option>Objekt / Sonstiges</option></select></div></section>
<section class="section"><h2>Projekt</h2><div class="quick"><button class="btn" id="btnSave">Speichern</button><button class="btn danger" id="btnClearData">Leeren</button></div></section>
</aside>
<section id="mapWrap"><div id="map"></div><div class="map-actions"><button type="button" class="btn measure-btn" id="btnMeasure" title="Messwerkzeug" aria-label="Messwerkzeug"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 17 17 4l3 3L7 20H4z"/><path d="m8 16 2 2M11 13l2 2M14 10l2 2M17 7l2 2"/></svg><span>Messen</span></button><button type="button" class="btn" id="btnFullscreen">⛶</button></div><div id="measurePanel" class="measure-panel hidden"><div class="measure-head"><strong>Messwerkzeug</strong><button type="button" class="btn iconbtn" id="btnMeasureClose">×</button></div><div class="measure-tools"><button type="button" class="btn" id="measureDistance">📏 Strecke</button><button type="button" class="btn" id="measureArea">⬡ Fläche</button><button type="button" class="btn" id="measureFinish">✓ Fertig</button><button type="button" class="btn danger" id="measureCancel">Abbrechen</button></div><div id="measureReadout" class="measure-readout">Messmodus auswählen.</div></div>
<div id="drawPanel" class="draw-panel hidden"><div class="draw-head"><strong>Grundrissmodus</strong><button class="btn iconbtn" id="btnGroundplanClose">×</button></div><div class="draw-tools"><button class="btn" id="drawLine">╱ Linie</button><button class="btn" id="drawFreehand">✎ Freihand</button><button class="btn" id="drawText">T Text</button><button class="btn" id="drawRect">□ Rechteck</button><button class="btn" id="drawPoly">⬡ Polygon</button><button class="btn" id="drawEdit">✥ Bearbeiten</button><button class="btn" id="drawDelete">⌫ Löschen</button><button class="btn" id="drawClear">Alles löschen</button><button class="btn" id="drawImage">Bildgrundriss</button></div></div>
<div class="legend"><div><span>Fälle</span><strong id="caseCount">0</strong></div><div><span>Tracks</span><strong id="trackCount">0</strong></div><div><span>Grundrissobjekte</span><strong id="annotationCount">0</strong></div><div><span>Letzte Speicherung</span><strong id="lastSaved">—</strong></div></div></section>
</main></div>

<!-- Case Modal -->
<div id="caseModal" class="modal-backdrop"><div class="modal"><div class="modal-head"><h2 id="caseModalTitle">Sichtung erfassen</h2><button class="btn iconbtn" data-close="caseModal">×</button></div><div class="modal-body"><div class="grid2">
<div class="field"><label>Datum *</label><input id="caseDate" type="date"></div><div class="field"><label>Uhrzeit *</label><input id="caseTime" type="time"></div><div class="field"><label>Ort</label><input id="casePlace"></div><div class="field"><label>Phänomen-Art</label><select id="caseType"><option>EVP / Stimme</option><option>Licht / Orb</option><option>Schatten / Gestalt</option><option>EMF-Anomalie</option><option>Temperatur-Anomalie</option><option>Bewegung / Sensor</option><option>Objekt / Sonstiges</option></select></div>
<div class="field"><label>Latitude *</label><input id="caseLat" class="readonly" readonly></div><div class="field"><label>Longitude *</label><input id="caseLng" class="readonly" readonly></div><div class="field"><label>EMF</label><input id="caseEmf" type="number" step="0.01"></div><div class="field"><label>Temperatur °C</label><input id="caseTemp" type="number" step="0.1"></div><div class="field full"><label>Wetter / Bedingungen</label><input id="caseWeather"></div><div class="field full"><label>Geräte</label><select id="caseDevices" multiple><option>K2 Meter</option><option>Wärmebild</option><option>Drohne</option><option>DSLR Kamera</option><option>Nachtsicht / IR</option><option>Endoskopcam</option><option>Actioncam</option><option>Handy</option><option>Audio-Recorder</option><option>Sonstiges</option></select></div><div class="field full"><label>Beschreibung</label><textarea id="caseDesc"></textarea></div><div class="field full"><label>Beweisfotos</label><input id="casePhotos" type="file" accept="image/*" multiple></div></div>
<div style="margin-top:12px"><div class="table-head"><h2 style="font-size:10px;color:#9db8ad;letter-spacing:.14em;text-transform:uppercase;margin:0">Astronomische Metadaten</h2><button class="btn" id="btnAstroRecalc">↻ automatisch</button></div><div class="grid3" style="margin-top:8px"><div class="astro-card"><label>Mondphase</label><input id="astroMoon"></div><div class="astro-card"><label>Illumination %</label><input id="astroIllum" type="number" min="0" max="100" step="0.1"></div><div class="astro-card"><label>Tageszeit</label><select id="astroDay"><option>Tag</option><option>bürgerliche Dämmerung</option><option>nautische Dämmerung</option><option>astronomische Dämmerung</option><option>Nacht</option></select></div><div class="astro-card"><label>Sonnenaufgang</label><input id="astroSunrise" type="time"></div><div class="astro-card"><label>Sonnenuntergang</label><input id="astroSunset" type="time"></div><div class="astro-card"><label>Solarhöhe °</label><input id="astroAlt" type="number" step="0.01"></div></div></div>
<div class="astro-actions"><button class="btn cyan" id="btnCaseAudio">◉ EVP Studio</button><span class="tiny" id="caseAudioInfo" title="Fallbezogene EVP-Audios öffnen">0 Audio</span></div>
<div class="subpanel"><div class="table-head"><h2 style="font-size:10px;color:#9db8ad;letter-spacing:.14em;text-transform:uppercase;margin:0">Zugehörige EVP-Audios</h2><button class="btn" id="btnCaseAudioRefresh">↻</button></div><div id="caseAudioList" class="audio-list"></div></div>
