function begin(){const cases=selectedCases(),tracks=selectedTracks();if(!$('r13IncCases').checked&&!$('r13IncTracks').checked&&!$('r13IncFloor').checked&&!$('r13IncAudio').checked&&!$('r13IncPhotos').checked){progress(0,'Bitte mindestens ein Berichtmodul auswählen.');return null}if($('r13IncCases').checked&&!cases.length){progress(0,'Bitte mindestens einen Fall auswählen.');return null}progress(18,'Daten werden ausgewertet …');const sheet=$('reportPrintSheetV13');sheet.innerHTML=buildPrint(cases,tracks);lastSelectedCases=cases;lastSelectedTracks=tracks;progress(72,'Berichtslayout erstellt.');return sheet}
function createPDF(){const sheet=begin();if(!sheet)return;document.body.classList.add('print-report-v13');progress(88,'Druckansicht wird vorbereitet …');setTimeout(()=>{window.print();setTimeout(()=>{document.body.classList.remove('print-report-v13');progress(100,'Fertig. Im Druckdialog PDF speichern wählen.');},800)},80)}
function createXLSX(){const cases=selectedCases(),tracks=selectedTracks();if(!$('r13IncCases').checked&&$('r13IncTracks').checked===false){progress(0,'Bitte mindestens Fälle oder Tracks auswählen.');return}const s=getState(),a=calculate(s,cases,tracks);if(!window.XLSX){createCSV();return}progress(22,'Excel-Arbeitsmappe wird aufgebaut …');const wb=XLSX.utils.book_new();const summary=[['FELDBERICHT',''],['Erstellt',new Date().toLocaleString('de-DE')],['Fälle',cases.length],['Tracks',tracks.length],['Trackdistanz (km)',Number(a.trackDist/1000).toFixed(3)],['Trackpunkte',a.trackPts],['EVP',a.audios.length],['Fotos',a.photos],['EMF-Messungen',a.emfVals.length],['Temperaturwerte',a.tempVals.length],['Ø EMF',a.emfVals.length?(sum(a.emfVals,x=>x)/a.emfVals.length).toFixed(3):''],['Ø Temperatur',a.tempVals.length?(sum(a.tempVals,x=>x)/a.tempVals.length).toFixed(2):'']];XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(summary),'Zusammenfassung');
const caseRows=cases.map(c=>({Ort:c.place||'',Datum:c.date||'',Uhrzeit:c.time||'',Latitude:c.lat,Longitude:c.lng,Phänomen:c.type||'',Geräte:(c.devices||[]).join(', '),EMF:c.emf||'',Temperatur:c.temp||'',Wetter:c.weather||'',Mondphase:astro(c,'moonPhase',''),Illumination:astro(c,'moonIllum',''),Tageszeit:astro(c,'dayStatus',''),Sonnenaufgang:astro(c,'sunrise',''),Sonnenuntergang:astro(c,'sunset',''),Solarhöhe:astro(c,'solarAltitude',''),Fotos:c.photos?.length||0,EVP:c.audioSamples?.length||0,Beschreibung:c.description||''}));XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(caseRows),'Fälle');
const trackRows=tracks.map(t=>({Track:t.name||'',Punkte:trackPoints(t).length,Distanz_km:Number((t.distance||0)/1000).toFixed(3),Dauer:fmtDur(t.duration||0),Start:t.startedAt||'',Ende:t.endedAt||''}));XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(trackRows),'Tracks');
const audioRows=a.audios.map(x=>({Name:x.name||'',Fall:s.cases.find(c=>c.id===x.caseId)?.place||'',Dauer_s:Number(x.stats?.duration||0).toFixed(2),RMS:Number(x.stats?.rms||0).toFixed(5),Peak:Number(x.stats?.peak||0).toFixed(5),Clipping_pct:Number(x.stats?.clipping||0).toFixed(2),SampleRate_Hz:x.stats?.sampleRate||''}));XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(audioRows),'EVP');
const devRows=Object.entries(a.dev).sort((x,y)=>y[1]-x[1]).map(([Gerät,Anzahl])=>({Gerät,Anzahl}));XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(devRows),'Geräte');
const shape={};a.annotations.forEach(x=>{const k=x.properties?.kind==='text'?'Text':x.properties?.shape||'Geometrie';shape[k]=(shape[k]||0)+1});XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(Object.entries(shape).map(([Objektart,Anzahl])=>({Objektart,Anzahl}))),'Grundriss');
XLSX.writeFile(wb,'ghosthunting_feldbericht.xlsx');progress(100,'Excel-Arbeitsmappe erstellt.')}
function createCSV(){const cases=selectedCases();if(!cases.length){progress(0,'Bitte mindestens einen Fall auswählen.');return}const rows=cases.map(c=>({Ort:c.place||'',Datum:c.date||'',Uhrzeit:c.time||'',Latitude:c.lat,Longitude:c.lng,Phänomen:c.type||'',Geräte:(c.devices||[]).join(', '),EMF:c.emf||'',Temperatur:c.temp||'',Wetter:c.weather||'',Mondphase:astro(c,'moonPhase',''),Illumination:astro(c,'moonIllum',''),Tageszeit:astro(c,'dayStatus',''),Fotos:c.photos?.length||0,EVP:c.audioSamples?.length||0}));const h=Object.keys(rows[0]);const csv=[h.join(';'),...rows.map(r=>h.map(k=>'"'+String(r[k]??'').replace(/"/g,'""')+'"').join(';'))].join('\r\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download='ghosthunting_feldbericht.csv';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),600);progress(100,'CSV erstellt.')}
function open(){ensureUI();populate();const m=$('reportV13Modal');if(!m){console.error('Report modal creation failed');return}m.classList.add('show');m.style.display='flex';requestAnimationFrame(()=>m.classList.add('show'))}
function bind(){const b=$('btnReports');if(!b){setTimeout(bind,100);return}if(b.dataset.reportV13Bound)return;b.dataset.reportV13Bound='1';b.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();open()},true)}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bind);else bind();window.GhosthuntReportV13={open,populate,createPDF,createXLSX,createCSV};
})();
</script>
