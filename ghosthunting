function trackPointsFromGeometry(t){
  return (t?.geometry?.coordinates||[]).map(c=>[Number(c[1]),Number(c[0])]).filter(p=>Number.isFinite(p[0])&&Number.isFinite(p[1]));
}
function trackGeometryFromPoints(points){return{type:'LineString',coordinates:points.map(p=>[p[1],p[0]])}}
function createTrackLine(t,opts={}){
  const pts=trackPointsFromGeometry(t);
  const l=L.polyline(pts,{color:t.color||'#00e5ff',weight:opts.weight||4,opacity:opts.opacity??.9,pmIgnore:true});
  l._trackId=t.id;return l;
}
function renderTracks(){
  if(!trackLayer)trackLayer=L.featureGroup().addTo(map);
