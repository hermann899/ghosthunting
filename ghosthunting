  const html=`<div class="popup"><h3>${esc(t.name||'Track')}</h3><div class="meta">${t.points||trackPointsFromGeometry(t).length} Punkte · ${(Number(t.distance||0)/1000).toFixed(2)} km</div><div class="quick"><button type="button" class="btn primary" data-track-edit="${esc(id)}">✎ Bearbeiten</button><button type="button" class="btn" data-track-zoom="${esc(id)}">⌕ Zoom</button><button type="button" class="btn danger" data-track-delete="${esc(id)}">⌫ Löschen</button></div></div>`;
  line.bindPopup(html,{autoPan:true,closeButton:true,closeOnClick:false});
